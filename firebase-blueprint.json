{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with level progression and virtual coin balance",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarEmoji": { "type": "string" },
        "role": { "type": "string" },
        "currentLevel": { "type": "integer" },
        "highestLevelReached": { "type": "integer" },
        "totalCoins": { "type": "integer" },
        "totalStars": { "type": "integer" },
        "matchesCount": { "type": "integer" },
        "levelsWon": { "type": "integer" },
        "levelsFailed": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "totalCoins", "currentLevel"]
    },
    "CoinTransaction": {
      "title": "CoinTransaction",
      "description": "Cryptographic record of virtual coin reward or spend",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "integer" },
        "levelNumber": { "type": "integer" },
        "description": { "type": "string" },
        "timestamp": { "type": "integer" }
      },
      "required": ["id", "userId", "amount", "type"]
    },
    "Level": {
      "title": "Level",
      "description": "Puzzle level definition and rewards",
      "type": "object",
      "properties": {
        "levelNumber": { "type": "integer" },
        "name": { "type": "string" },
        "themeName": { "type": "string" },
        "difficulty": { "type": "string" },
        "baseReward": { "type": "integer" },
        "bonusReward": { "type": "integer" },
        "timeLimitSeconds": { "type": "integer" },
        "trayCapacity": { "type": "integer" },
        "tilesJson": { "type": "string" },
        "isActive": { "type": "boolean" },
        "highStars": { "type": "integer" },
        "isCompleted": { "type": "boolean" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["levelNumber", "name", "baseReward"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "In-app broadcast announcements published by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "dateString": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "content"]
    },
    "Task": {
      "title": "Task",
      "description": "Daily quests and admin-created tasks synchronized across all devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetProgress": { "type": "integer" },
        "rewardCoins": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "integer" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "title", "rewardCoins", "targetProgress"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Global game economy and configuration settings",
      "type": "object",
      "properties": {
        "configKey": { "type": "string" },
        "configValue": { "type": "string" },
        "updatedAt": { "type": "integer" },
        "updatedBy": { "type": "string" }
      },
      "required": ["configKey", "configValue"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Admin activity audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "integer" },
        "adminName": { "type": "string" },
        "actionType": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "adminName", "actionType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile document containing coin balance and level progress"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": "CoinTransaction",
      "description": "User transaction ledger of earned and spent virtual coins"
    },
    "/levels/{levelId}": {
      "schema": "Level",
      "description": "Published puzzle level catalog synchronized across all player devices"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Admin published broadcast announcements synchronized in real-time"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Admin created tasks and daily quests synchronized across all devices"
    },
    "/admin_configs/{configKey}": {
      "schema": "AdminConfig",
      "description": "Global game economy parameters and configurations"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Administrative actions and security event log"
    }
  }
}
