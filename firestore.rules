rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          'chrstphrnch@gmail.com',
          'christopherenoch767@gmail.com',
          'Christophertersee21@gmail.com',
          'wmy3057@gmail.com',
          'admin@puzzlepop.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['SUPER_ADMIN', 'ADMIN'])
      );
    }

    // User profile and progress
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }
    }

    // Shared puzzle levels: Readable by all, writable only by admins
    match /levels/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Broadcast announcements: Readable by all, writable only by admins
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Synchronized tasks / quests: Readable by all, writable only by admins
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Global economy configs: Readable by all, writable only by admins
    match /admin_configs/{configKey} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Security & audit logs: Admin only
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
